# Copy to .env and export (set -a; source .env; set +a) before running.
AQUA_HOST=0.0.0.0
AQUA_PORT=8000
AQUA_WAYPOINTS=sample_data/waypoints.json
AQUA_GPS_PORT=/dev/serial0
AQUA_GPS_BAUD=9600
AQUA_I2C_BUS=1
AQUA_MAG_DECLINATION_DEG=0.0
AQUA_OBSTACLE_STOP_CM=60
AQUA_ARRIVAL_RADIUS_M=3.0
AQUA_BASE_SPEED=0.6
AQUA_CONVEYOR_SPEED=0.5
AQUA_DEADMAN_S=1.0
AQUA_YOLO_MODEL=yolov8n.pt
AQUA_CAMERA_INDEX=0
AQUA_DETECT_CONF=0.4
